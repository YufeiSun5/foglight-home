; Independent cloud feasibility pilot, not production game.
config_version=5
[application]
config/name="Foglight Workshop Pilot"
run/main_scene="res://src/pilot.tscn"
[display]
window/size/viewport_width=1672
window/size/viewport_height=941
window/size/window_width_override=1254
window/size/window_height_override=706
window/stretch/mode="viewport"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
